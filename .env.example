# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL 16. A dedicated database for this project.
DATABASE_URL=postgresql://algotrading:change-me@localhost:5432/algotrading

# 32 random bytes, base64. Generate with: npm run keygen
# Wraps the per-secret data keys for broker credentials. Losing it loses
# every stored credential; rotating it requires re-encrypting them.
MASTER_KEY=

# 32+ random bytes, base64. Generate with: npm run keygen
# Signs session cookies. Rotating it logs everyone out.
SESSION_SECRET=

# Session cookie lifetime. Default 12 hours.
SESSION_TTL_SECONDS=43200
